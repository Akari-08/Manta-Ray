# Generate two distinct tokens: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_TOKEN=replace-with-random-device-token
CONTROL_TOKEN=replace-with-different-random-control-token
ROBOT_ID=manta-01
# Set to this computer's Wi-Fi IPv4 for hardware, e.g. 192.168.1.40. Never use 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Explicit opt-in for synthetic telemetry. Set 0 for hardware sessions.
ALLOW_SIMULATOR=0
# Optional simulator overrides (same private LAN / loopback computer):
# BACKEND_WS=ws://127.0.0.1:3000/ws/device
# SIMULATOR_HOST=127.0.0.1
